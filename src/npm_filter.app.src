{application, npm_filter, [
    {description, "em_filter agent for npm package search"},
    {vsn, "0.2.0"},
    {registered, [npm_filter_sup, npm_filter_server]},
    {mod, {npm_filter_app, []}},
    {applications, [kernel, stdlib, cowboy,
        em_filter]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        npm_filter_sup,
        npm_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/npm_filter"}]}
]}.
